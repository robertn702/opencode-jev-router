{
  "name": "@robertn702/opencode-jev-router",
  "version": "0.2.0",
  "description": "Adaptive reasoning effort for OpenCode with request-local GPT-6 model selection",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/opencode-jev-router.git"
  },
  "bugs": "https://github.com/robertn702/opencode-jev-router/issues",
  "homepage": "https://github.com/robertn702/opencode-jev-router#readme",
  "bin": {
    "opencode-jev-router": "./dist/index.js"
  },
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./plugin": "./dist/plugin.js",
    "./server": "./dist/plugin.js"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    ".env.example"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run typecheck:cache && npm test && node --test eval/run.test.mjs eval/evidence.test.mjs",
    "prepack": "npm run build",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:plugin": "node scripts/plugin-smoke.mjs",
    "eval": "tsx test/eval/jev-eval.ts",
    "eval:live": "node test/eval/live-matrix.mjs",
    "cache:validate": "tsx scripts/cache-validation.ts",
    "typecheck:cache": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --types node scripts/cache-validation.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
