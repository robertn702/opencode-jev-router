JEV_PROXY_PORT=4320
UPSTREAM_MODE=cliproxy
UPSTREAM_BASE_URL=http://127.0.0.1:8317/v1
# Direct OpenAI: UPSTREAM_MODE=openai, UPSTREAM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY is required in openai mode only; never commit a real key.
# OPENAI_API_KEY=
UPSTREAM_MODEL=gpt-6-astra
BASE_EFFORT=medium
JEV_TIMEOUT_MS=4000
MAX_REQUEST_BYTES=1048576
MAX_IN_FLIGHT=32
UPSTREAM_HEADER_TIMEOUT_MS=10000
UPSTREAM_IDLE_TIMEOUT_MS=60000
EFFORT_CACHE_ENTRIES=256
EFFORT_CACHE_TTL_MS=600000
TYPESAFE_API_KEY=
