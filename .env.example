JEV_PROXY_PORT=4320
UPSTREAM_BASE_URL=http://127.0.0.1:8317/v1
UPSTREAM_AUTH=forward
# Direct OpenAI: UPSTREAM_BASE_URL=https://api.openai.com/v1, UPSTREAM_AUTH=bearer
# UPSTREAM_API_KEY is required with bearer; never commit a real key.
# UPSTREAM_API_KEY=
# Select gpt-6-astra, gpt-6-luna, or gpt-6-sol through request.model.
# Optional global override; must be supported by every registered model.
# BASE_EFFORT=medium
JEV_TIMEOUT_MS=4000
# Optional local JSONL telemetry; use an absolute path (no prompts or tool content).
# JEV_DECISIONS_LOG_PATH=/home/user/.config/opencode/telemetry/jev-decisions.jsonl
MAX_REQUEST_BYTES=1048576
MAX_IN_FLIGHT=32
UPSTREAM_HEADER_TIMEOUT_MS=10000
UPSTREAM_IDLE_TIMEOUT_MS=60000
EFFORT_CACHE_ENTRIES=256
EFFORT_CACHE_TTL_MS=600000
SHUTDOWN_GRACE_MS=30000
TYPESAFE_API_KEY=
