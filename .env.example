JEV_ROUTER_PORT=4320
# Hosted Jev is the default classification backend.
# JEV_ROUTER_CLASSIFIER_BACKEND=jev
# TypeSafe key by default; Gateway requires its credential AND the URL below.
JEV_API_KEY=
# JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# For local classification, set the backend to laya and omit both Jev variables.
# The first request downloads ~1.7 GB to ~/.cache/receptron-laya and loads ~2 GB RAM.
# JEV_ROUTER_CLASSIFIER_BACKEND=laya
# JEV_ROUTER_LAYA_CACHE_DIR=/var/cache/receptron-laya
# JEV_ROUTER_LAYA_MODEL_DIR=/models/laya
# Required: any Responses API-compatible base URL that serves GPT-6 models.
JEV_ROUTER_UPSTREAM_BASE_URL=https://api.openai.com/v1
# bearer: the router sends JEV_ROUTER_UPSTREAM_API_KEY (HTTPS or loopback).
# forward: the router passes the client's Authorization header (loopback only).
JEV_ROUTER_UPSTREAM_AUTH=bearer
JEV_ROUTER_UPSTREAM_API_KEY=
# Optional Anthropic Messages API upstream. Uses JEV_ROUTER_UPSTREAM_AUTH policy.
# JEV_ROUTER_ANTHROPIC_UPSTREAM_BASE_URL=https://api.anthropic.com/v1
# JEV_ROUTER_ANTHROPIC_UPSTREAM_API_KEY=
# JEV_ROUTER_BASE_EFFORT=medium
JEV_ROUTER_CLASSIFICATION_TIMEOUT_MS=4000
JEV_ROUTER_MAX_RETRIES=1
JEV_ROUTER_FALLBACK_MODE=fixed
JEV_ROUTER_FALLBACK_EFFORT=high
# JEV_ROUTER_DECISIONS_LOG_PATH=/absolute/path/to/jev-decisions.jsonl
JEV_ROUTER_MAX_REQUEST_BYTES=1048576
JEV_ROUTER_MAX_IN_FLIGHT=32
JEV_ROUTER_UPSTREAM_HEADER_TIMEOUT_MS=10000
JEV_ROUTER_UPSTREAM_IDLE_TIMEOUT_MS=60000
JEV_ROUTER_EFFORT_CACHE_ENTRIES=256
JEV_ROUTER_EFFORT_CACHE_TTL_MS=600000
JEV_ROUTER_SHUTDOWN_GRACE_MS=30000
