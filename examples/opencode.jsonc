{
  // Works in OpenCode V1 and V2 (which normalizes this tuple).
  // For V2-only config, see examples/opencode-v2.jsonc.
  "$schema": "https://opencode.ai/config.json",
  "plugin": [["@robertn702/opencode-jev-router", {
    // Jev classifier key. For a direct TypeSafe key, delete jevBaseUrl.
    "jevApiKey": "{env:JEV_API_KEY}",
    "jevBaseUrl": "https://ai-gateway.vercel.sh/typesafe",
    // Any Responses API-compatible endpoint that serves GPT-6 models.
    "upstreamBaseURL": "https://api.openai.com/v1",
    "upstreamApiKey": "{env:OPENAI_API_KEY}",
    // Optional Claude models under jev-router, e.g. jev-router/claude-opus-5-5.
    // Either option enables them in V1 and V2.
    // "anthropicUpstreamBaseURL": "https://api.anthropic.com/v1",
    // "anthropicUpstreamApiKey": "{env:ANTHROPIC_API_KEY}"
    // Optional: an absolute path for metadata-only JevDecision JSONL events.
    // "decisionsLogPath": "/absolute/path/to/jev-decisions.jsonl"
  }]],
  "model": "jev-router/gpt-6-astra"
}
